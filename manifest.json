{
  "manifest_version": 3,
  "name": "TabMod",
  "version": "1.0.0",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "description": "__MSG_extDescription__",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "commands": {
    "save-all-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "__MSG_cmdSaveAll__"
    },
    "save-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_cmdSaveCurrent__"
    },
    "open-tabmod": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "__MSG_cmdOpenPopup__"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
